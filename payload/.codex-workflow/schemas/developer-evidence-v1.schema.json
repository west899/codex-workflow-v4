{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-workflow/developer-evidence-v1.schema.json",
  "title": "Codex Workflow Developer evidence contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_contract_version", "agent_id", "scopes", "commands", "claims", "handoff"],
  "properties": {
    "evidence_contract_version": {"const": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "targets", "observed_surfaces", "excluded_targets"],
        "properties": {
          "id": {"type": "string", "pattern": "^SCOPE-[A-Za-z0-9._-]+$"},
          "kind": {
            "enum": [
              "canonical_delivery_paths",
              "declared_path_call_graph",
              "explicit_command_set",
              "explicit_runtime_surfaces",
              "explicit_test_set",
              "repository_tree"
            ]
          },
          "targets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "observed_surfaces": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "excluded_targets": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "cwd", "exit_code", "expected_failure", "result", "scope_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^CMD-[A-Za-z0-9._-]+$"},
          "command": {"type": "string", "minLength": 1},
          "cwd": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer"},
          "expected_failure": {"type": "boolean"},
          "result": {"type": "string", "minLength": 1},
          "scope_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SCOPE-[A-Za-z0-9._-]+$"}}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "predicate", "scope_id", "supporting_command_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^CLAIM-[A-Za-z0-9._-]+$"},
          "kind": {"enum": ["static_analysis", "runtime_observation", "test_result", "manual_observation"]},
          "predicate": {"type": "string", "minLength": 1},
          "scope_id": {"type": "string", "pattern": "^SCOPE-[A-Za-z0-9._-]+$"},
          "supporting_command_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^CMD-[A-Za-z0-9._-]+$"}}
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_ids", "remaining_risks", "review_focus"],
      "properties": {
        "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^CLAIM-[A-Za-z0-9._-]+$"}},
        "remaining_risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "review_focus": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
