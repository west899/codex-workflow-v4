{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-workflow/review-evidence-v1.schema.json",
  "title": "Codex Workflow Review evidence contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_contract_version",
    "agent_id",
    "snapshot_id",
    "status",
    "findings",
    "requirement_checklist",
    "accepted_findings",
    "claim_assessments",
    "summary"
  ],
  "properties": {
    "evidence_contract_version": {"const": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["pass", "changes_requested"]},
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p0", "p1", "p2", "p3"],
      "properties": {
        "p0": {"type": "integer", "minimum": 0},
        "p1": {"type": "integer", "minimum": 0},
        "p2": {"type": "integer", "minimum": 0},
        "p3": {"type": "integer", "minimum": 0}
      }
    },
    "requirement_checklist": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "accepted_findings": {"type": "array", "items": true},
    "claim_assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "assessment", "evidence_fingerprint", "notes"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^CLAIM-[A-Za-z0-9._-]+$"},
          "assessment": {"enum": ["confirmed", "narrowed", "rejected", "unverified"]},
          "evidence_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary": {"type": "string", "minLength": 1}
  }
}
